{% from 'icons.jinja' import rss %}
<div x-data='{feedOptionsShown: false}' class='relative {{ extra_class|default('') }}'>
  <button x-on:mouseover='feedOptionsShown = true' x-on:touchend.passive='feedOptionsShown = true' 
          class='transition-colors hover:opacity-80 link-hover-muted text-muted'>
    {{ rss() }}
  </button>
  <ul x-cloak class='absolute end-0 top-8 border p-2 rounded-md shadow-lg transition-colors bg-card border-theme'
      x-show='feedOptionsShown' x-on:click.outside='feedOptionsShown = false'>
    <li><a href='/feeds.atom' class='block px-3 py-2 rounded transition-colors hover:opacity-80 link-hover-muted bg-hover-secondary text-primary'>Atom</a></li>
    <li><a href='/feeds.json' class='block px-3 py-2 rounded transition-colors hover:opacity-80 link-hover-muted bg-hover-secondary text-primary'>JSONFeed</a></li>
  </ul>
</div>
