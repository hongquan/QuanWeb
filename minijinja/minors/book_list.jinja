{% extends 'base.jinja' %}

{% from 'icons.jinja' import book_open %}

{%- block title %}{{ _f('books') }}{% endblock -%}

{% block inner_content %}
  <p>{{ _f('books-that-i-collected') }}</p>
  <dl class='mt-12 space-y-10 md:space-y-0 md:grid md:grid-cols-2 md:gap-x-8 md:gap-y-10'>
    {% for b in books -%}
      <div class='relative'>
        <dt>
          <a class='absolute flex items-center justify-center h-16 w-16 rounded-md bg-accent text-white hover:opacity-80 transition-opacity' href='{{ b.download_url }}' target='_blank' {% if no_tracking %}rel='noreferrer'{% endif %}>
            {{ book_open() }}
          </a>
          <h3 class='ml-20 text-lg leading-6 font-medium text-primary'>{{ b.title }}</h3>
        </dt>
        <dd class='mt-2 ml-20 text-base text-secondary'>
          <p>{{ b.author.name }}</p>
        </dd>
      </div>
    {%- endfor %}
  </dl>
{% endblock inner_content %}
