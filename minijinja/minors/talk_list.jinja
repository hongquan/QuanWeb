{% extends 'base.jinja' %}

{% from 'icons.jinja' import presentation %}

{%- block title %}{{ _f('presentations')|capitalize }}{% endblock title -%}

{% block inner_content %}
  <dl class='space-y-10 md:space-y-0 md:grid md:grid-cols-2 md:gap-x-8 md:gap-y-10'>
    {% for p in presentations %}
      <div class='relative'>
        <dt class='entry-header'>
          <a class='absolute flex items-center justify-center h-16 w-16 rounded-md bg-accent hover:opacity-80 text-white' href='{{ p.url }}' target='_blank' {% if no_tracking %}rel='noreferrer'{% endif %}>
            {{ presentation() }}
          </a>
          <h3 class='ml-20 text-lg leading-6 font-medium text-primary'>{{ p.title }}</h3>
        </dt>
        <dd class='mt-2 ml-20 text-base text-secondary'>
          Event: {{ p.event or '--' }}
        </dd>
      </div>
    {% endfor %}
  </dl>
{% endblock inner_content %}
