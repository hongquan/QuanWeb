<div class="z-10 border-b transition-colors floral-bg border-theme">
{% from 'icons.jinja' import search, menu_toggle, chevron_down %}
  <div class="nav-overlay">
    <nav class='mx-auto w-full max-w-6xl flex flex-wrap p-4 flex-col md:flex-row md:items-center space-y-4 md:space-y-0' 
         x-data="{ mobileMenuShown: false }">
    <div class='flex flex-row items-center'>
      <a href='/' 
         class='title-font font-medium items-center text-4xl nav-link-logo'>Quân</a>
      <div class='grow'></div>
      <div class='relative' x-data='{formShown: false}' x-cloak>
        <button class='text-right hidden xxs:block md:hidden flex me-3 nav-link-muted' 
                :class="{ 'active': formShown }"
                @click.stop='formShown = true'>
          {{ search(size=24, class='flex-none') }}
        </button>
        <!-- Floating search form for mobile -->
        <div class='absolute z-4 -start-8 -top-4' :class="formShown ? '' : 'hidden'" @click.outside='formShown = false' @keyup.escape='formShown = false'>
          {% with form_class='text-right me-3' %}
            {% include 'search_form.jinja' %}
          {% endwith %}
        </div>
        <!-- End search form -->
      </div>
      {% with form_class = 'text-right xxs:hidden me-3' %}
        {% include 'search_form.jinja' %}
      {% endwith %}
      <!-- To be shown for 24rem <= w < md screen -->
      <form class='text-right hidden xxs:block md:hidden me-3' method='post' action='/api/set-lang'>
        {% include 'lang_switcher.jinja' %}
      </form>
      {% with extra_class='hidden xxs:block md:hidden me-3' %}
        {% include 'feeds_menu.jinja' %}
      {% endwith %}
      <button class='md:hidden rounded-lg focus:outline-none focus:shadow-outline nav-link-muted' 
              :class="{ 'active': mobileMenuShown }"
              @click='mobileMenuShown = !mobileMenuShown'>
        {{ menu_toggle() }}
      </button>
    </div>
    <!-- To be shown for < 24rem screen -->
    <div class='flex flex-row justify-end xxs:hidden'>
      <form class='text-right md:hidden me-3' method='post' action='/api/set-lang'>
        {% include 'lang_switcher.jinja' %}
      </form>
      {% with extra_class='md:hidden me-3' %}
        {% include 'feeds_menu.jinja' %}
      {% endwith %}
    </div>
    <ul id='navbar-main' class='md:ml-4 md:space-x-1 space-y-1 md:space-y-0 w-full md:w-auto md:block text-base'
        :class="{hidden: !mobileMenuShown}">
      <li class='md:inline relative' x-data='{open: false}'>
        <a class='flex flex-row md:inline px-4 py-2 mt-2 rounded-lg md:mt-0 nav-link' 
           :class="{ 'active': open }"
           href='/blog/' @click.prevent='open = !open'>
          <span class='flex-grow'>Blog</span>
          {{ chevron_down() }}
        </a>
        <ul class='md:absolute left-0 md:min-w-max md:mt-2 origin-top-right rounded-md shadow-lg px-2 py-2 border transition-colors bg-card border-theme'
            aria-labelledby='themes'
            x-show='open' @click.away='open = false' x-cloak>
          {% for cat in categories %}
            <li x-data="{ hovered: false }">
              <a href='/category/{{ cat.slug }}/' 
                 class='block px-4 py-2 mt-2 rounded-lg md:mt-0 nav-dropdown-link'
                 :class="{ 'active': hovered }"
                 @mouseenter="hovered = true"
                 @mouseleave="hovered = false">{{ cat.title_vi if lang == 'vi' and cat.title_vi else cat.title }}</a>
            </li>
          {% endfor %}
          <li class='divider'></li>
          <li x-data="{ hovered: false }">
            <a href="/category/_uncategorized/"
                class='block px-4 py-2 mt-2 rounded-lg md:mt-0 nav-dropdown-link'
                :class="{ 'active': hovered }"
                @mouseenter="hovered = true"
                @mouseleave="hovered = false">Uncategorized</a>
          </li>
        </ul>
      </li>

      <li class='md:inline'>
        <a href='/book/' 
           class='flex flex-row md:inline px-4 py-2 mt-2 rounded-lg md:mt-0 nav-link'>{{ _f('books') }}</a>
      </li>

      <li class='md:inline'>
        <a href='/talk/' 
           class='flex flex-row md:inline px-4 py-2 mt-2 rounded-lg md:mt-0 nav-link'>{{ _f('talks') }}</a>
      </li>

      <li class='md:inline'>
        <a href='/Downloads/CV-Quan.pdf' 
           class='flex flex-row md:inline px-4 py-2 mt-2 rounded-lg md:mt-0 nav-link'>CV</a>
      </li>
    </ul>

    <div class='hidden md:block md:grow'></div>
    {% with form_class = 'text-right hidden md:block me-3' %}
      {% include 'search_form.jinja' %}
    {% endwith %}
    <form class='text-right hidden md:block me-3' method='post' action='/api/set-lang'>
      {% include 'lang_switcher.jinja' %}
    </form>
    {% with extra_class='hidden md:block me-3' %}
      {% include 'feeds_menu.jinja' %}
    {% endwith %}

  </nav>
  </div>
  <script>
    document.addEventListener('alpine:init', () => {
      Alpine.data('search_app', () => ({
        keywords: '',
        get query() {
          return this.keywords.trim().replace(/\s+/g, ' ') + ' site:quan.hoabinh.vn'
        }
      }))
    })
  </script>
</div>
