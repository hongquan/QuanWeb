{% from 'icons.jinja' import github, bitbucket, gitlab, linkedin %}
<footer id='footer-page' class="mt-8 text-sm flex-none border-t py-6 transition-colors bg-secondary border-theme">
  <div class='text-center mb-3 text-muted'>{{ _f('see-my-work-at') }}</div>
  <ul id='brands' class='text-center px-4 py-2 text-sm font-medium text-secondary'>
    <li class='inline-block mx-2'>
      <a href='https://github.com/hongquan/' title='GitHub' class='block transition-colors hover:opacity-80 link-hover-secondary text-secondary'>
        {{ github() }}
      </a>
    </li>
    <li class='inline-block mx-2'>
      <a href='https://bitbucket.org/hongquan/' title='BitBucket' class='block transition-colors hover:opacity-80 link-hover-secondary text-secondary'>
        {{ bitbucket() }}
      </a>
    </li>
    <li class='inline-block mx-2'>
      <a href='https://gitlab.com/quan' title='GitLab' class='block transition-colors hover:opacity-80 link-hover-secondary text-secondary'>
        {{ gitlab() }}
      </a>
    </li>
    <li class='inline-block mx-2'>
      <a href='https://www.linkedin.com/in/bachkhois/' title='LinkedIn' class='block transition-colors hover:opacity-80 link-hover-secondary text-secondary'>
        {{ linkedin() }}
      </a>
    </li>
  </ul>
  <p class='text-center text-xs mt-4 text-muted'>
    This site supports <a href='http://www.mozilla.org' class='transition-colors hover:opacity-80 link-hover-muted text-muted'>Firefox</a>, <a href='http://www.google.com/chrome/' class='transition-colors hover:opacity-80 link-hover-muted text-muted'>Chrome</a>, <a href='http://www.opera.com' class='transition-colors hover:opacity-80 link-hover-muted text-muted'>Opera</a> browsers.
  </p>
</footer>
